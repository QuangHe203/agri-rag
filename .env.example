# ─────────────────────────────────────────────────────────────────────────────
# Agriculture RAG Backend — Environment Variables Example
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development          # development | production

# Storage paths (relative to project root)
UPLOAD_DIR=./data/uploads
VECTOR_DB_PATH=./data/vector_db
SQLITE_DB_PATH=./data/documents.db

# ChromaDB collection name
COLLECTION_NAME=agriculture_knowledge

# Embedding model (runs locally, no API key required)
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps

# Text chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
DEFAULT_TOP_K=5
MAX_TOP_K=10
MIN_RELEVANCE_SCORE=0.45

# Reranking (cross-encoder) — optional
RERANK_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_MIN_SCORE=0.0

# Hybrid search (BM25 + vector, fused with RRF) — optional
HYBRID_SEARCH_ENABLED=false
HYBRID_CANDIDATE_MULTIPLIER=4
BM25_INDEX_PATH=./data/bm25_index.pkl

# Query transformation (uses the LLM, runs before retrieval) — all optional
# QUERY_REWRITE_ENABLED : viết lại câu hỏi thành một truy vấn tìm kiếm rõ ràng
# MULTI_QUERY_ENABLED   : sinh nhiều biến thể câu hỏi rồi hợp nhất bằng RRF
# MULTI_QUERY_COUNT     : số biến thể tạo thêm (không tính câu gốc)
# HYDE_ENABLED          : nhúng đoạn văn trả lời giả định cho nhánh vector
QUERY_REWRITE_ENABLED=false
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3
HYDE_ENABLED=false
QUERY_TRANSFORM_CANDIDATE_MULTIPLIER=4

# LLM provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=               # ← Fill in your Gemini API key here
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.1

# Upload / request limits
MAX_UPLOAD_SIZE_MB=50
MAX_QUESTION_LENGTH=2000

# CORS (comma-separated list of allowed origins, or * for all)
# CORS_ORIGINS=["http://localhost:3000","https://your-frontend.example.com"]

# ── SSL / Proxy (corporate environments) ─────────────────────────────────────
# If you see "CERTIFICATE_VERIFY_FAILED" when downloading the embedding model
# from HuggingFace, your network uses a self-signed corporate CA certificate.
# The app already uses truststore (OS certificate store) automatically.
# If that is not enough, point Python to your corporate CA bundle:
# REQUESTS_CA_BUNDLE=C:/path/to/corporate-ca.pem
# SSL_CERT_FILE=C:/path/to/corporate-ca.pem
# Or, as a last resort for internal/dev use only (NOT for production):
# PYTHONHTTPSVERIFY=0
